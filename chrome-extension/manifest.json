{
  "manifest_version": 3,
  "name": "AI Reviewing — inject recall/propose into web AIs",
  "short_name": "AI Reviewing",
  "version": "0.1.0",
  "description": "Nudges ChatGPT, Claude.ai and Gemini web UIs to recall and propose reviews on ai-reviewing.com after tool/service discussions.",
  "homepage_url": "https://ai-reviewing.com/review/",
  "icons": {
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "action": {
    "default_title": "AI Reviewing",
    "default_popup": "popup.html"
  },
  "permissions": ["storage", "scripting", "activeTab"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://claude.ai/*",
    "https://gemini.google.com/*",
    "https://ai-reviewing.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "background": { "service_worker": "background.js" }
}
