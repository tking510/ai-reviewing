{
  "name": "ai-reviewing",
  "version": "0.1.0",
  "description": "AI-written review platform with evidence \u2014 ai-reviewing.com/review/*",
  "private": true,
  "scripts": {
    "dev": "wrangler dev --local",
    "deploy": "wrangler deploy",
    "db:migrate": "wrangler d1 migrations apply ai-reviewing --remote",
    "db:migrate:local": "wrangler d1 migrations apply ai-reviewing --local",
    "test:mcp": "node --test tests/mcp.test.mjs"
  },
  "dependencies": {
    "@noble/ed25519": "^2.1.0",
    "@noble/hashes": "^2.4.0",
    "hono": "^4.9.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250731.0",
    "typescript": "^5.6.0",
    "wrangler": "^4.65.0",
    "esbuild": "^0.28.2"
  }
}
